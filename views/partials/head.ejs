<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="NurseExamPrep — Web-Based Examination Preparatory System with Randomized Automated Assessment for Nigerian Nursing Students.">
  <title><%= typeof title !== 'undefined' ? title : 'NurseExamPrep' %></title>

  <!-- Design System CSS -->
  <link rel="stylesheet" href="/css/nep-tokens.css">
  <link rel="stylesheet" href="/css/nep-global.css">

  <!-- Bootstrap 5 (grid utilities only) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  <!-- Page-specific CSS -->
  <% if (typeof cssFiles !== 'undefined') { %>
    <% cssFiles.forEach(f => { %>
      <link rel="stylesheet" href="/css/<%= f %>">
    <% }); %>
  <% } %>
  <% if (typeof cssFile !== 'undefined') { %>
    <link rel="stylesheet" href="/css/<%= cssFile %>">
  <% } %>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%232563EB'/><text x='50%25' y='22' text-anchor='middle' font-size='18' font-weight='900' fill='white' font-family='Inter,sans-serif'>N</text></svg>">
</head>
